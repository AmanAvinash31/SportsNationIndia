# Copy to .env for local runs. On a host, set these in its dashboard.
PORT=5000
# Public address, no trailing slash. Used for canonical links, sitemap and social previews.
SITE_URL=https://momentumindia.in
# Folder on a persistent disk where data.db lives.
DATA_DIR=./
# Long random string (16+ characters) to sign in at /admin. Leave empty to switch admin off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
